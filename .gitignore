# ==========================================
# Scropio DB - .gitignore
# ==========================================

# ------------------------------------------
# Python
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ------------------------------------------
# C++
# ------------------------------------------
# Object files
*.o
*.obj
*.lo

# Executables and compiled binaries
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.a
*.lib

# Debug files
*.pdb
*.idb
*.ilk
*.sdf
*.suo
*.user
*.opensdf

# Build directories and CMake
build/
Build/
bin/
Bin/
CMakeFiles/
CMakeCache.txt
Makefile
*.cmake
compile_commands.json

# Visual Studio / MSVC
*.vcxproj
*.vcxproj.filters
*.sln
*.suo
*.user
*.sdf
*.VC.db
*.VC.opendb

# ------------------------------------------
# Database Files (Local / Temporary)
# ------------------------------------------
# Prevent committing local database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.mdb
*.accdb
data/local_*.db

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
config.local.json

# ------------------------------------------
# IDE & Editors (VS Code)
# ------------------------------------------
.vscode/
*.code-workspace
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# Operating System (Windows / macOS / Linux)
# ------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ------------------------------------------
# Logs and Temporary Files
# ------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
*~